---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import CTABanner from '../../components/cards/CTABanner.astro';
import type { Locale } from '../../i18n/locales';
import { pickCopy } from '../../i18n/copy';
import { href } from '../../i18n/routes';
import en from './sampleAudit.en';
import fr from './sampleAudit.fr';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = pickCopy({ en, fr }, locale, 'views/sample-audit');
---

<BaseLayout locale={locale}
  title={c.metaTitle}
  description={c.metaDescription}
>
  <section class="sa-hero">
    <div class="sa-hero__inner">
      <div class="sa-hero__main">
        <p class="sa-hero__eyebrow">{c.d1}</p>
        <h1 class="sa-hero__title">{c.d2}</h1>
        <p class="sa-hero__subline">{c.d3}</p>
        <p class="sa-hero__subline sa-hero__subline--note" set:html={c.d4Html}></p>
      </div>
      <aside class="sa-hero__aside" aria-label={c.engagementDetails}>
        <div class="sa-snap">
          <p class="sa-snap__label">{c.d5}</p>
          <div class="sa-snap__detail">
            <span class="sa-snap__name">{c.d6}</span>
            <span class="sa-snap__meta">{c.d7}</span>
            <span class="sa-snap__meta">{c.d8}</span>
          </div>
        </div>
        <div class="sa-snap-row">
          <div class="sa-snap sa-snap--inline">
            <p class="sa-snap__label">{c.d9}</p>
            <a href={href('audit', locale)} class="sa-snap__tile">
              <span class="sa-snap__tile-name">{c.d10}</span>
              <span class="sa-snap__tile-arrow" aria-hidden="true" set:html={c.d11Html}></span>
            </a>
          </div>
          <div class="sa-snap-divider" aria-hidden="true">{c.d12}</div>
          <div class="sa-snap sa-snap--inline">
            <p class="sa-snap__label">{c.d13}</p>
            <div class="sa-snap__tools">
              <a href={href('tech:airbyte', locale)} class="sa-snap__tile">
                <img src="/logos/airbyte.svg" alt="" class="sa-snap__tile-logo" width="20" height="20" loading="lazy" />
                <span class="sa-snap__tile-name">{c.d14}</span>
              </a>
              <a href={href('tech:bigquery', locale)} class="sa-snap__tile">
                <img src="/logos/bigquery.svg" alt="" class="sa-snap__tile-logo" width="20" height="20" loading="lazy" />
                <span class="sa-snap__tile-name">{c.d15}</span>
              </a>
              <a href={href('tech:dataform', locale)} class="sa-snap__tile">
                <img src="/logos/dataform.svg" alt="" class="sa-snap__tile-logo" width="20" height="20" loading="lazy" />
                <span class="sa-snap__tile-name">{c.d16}</span>
              </a>
              <a href={href('tech:steep', locale)} class="sa-snap__tile">
                <img src="/logos/steep.svg" alt="" class="sa-snap__tile-logo" width="20" height="20" loading="lazy" />
                <span class="sa-snap__tile-name">{c.d17}</span>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>


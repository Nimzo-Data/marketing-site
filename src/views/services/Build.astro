---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import TwoColumnSplit from '../../components/content/TwoColumnSplit.astro';
import DataPlatformDiagram from '../../components/content/DataPlatformDiagram.astro';
import PricingRange from '../../components/content/PricingRange.astro';
import ProcessSteps from '../../components/content/ProcessSteps.astro';
import LogoGrid from '../../components/content/LogoGrid.astro';
import LeadCard from '../../components/cards/LeadCard.astro';
import { getServiceLeads } from '../../data/services';
import ResultBlock from '../../components/content/ResultBlock.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import { getTechnologiesForGrid } from '../../data/technologies';
import type { Locale } from '../../i18n/locales';
import { pickCopy } from '../../i18n/copy';
import { href } from '../../i18n/routes';
import en from './build.en';
import fr from './build.fr';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = pickCopy({ en, fr }, locale, 'views/services/build');
const serviceLeads = getServiceLeads(locale);
---

<ServiceLayout locale={locale}
  title={c.metaTitle}
  description={c.metaDescription}
  heroTitle={c.heroTitle}
  heroSubtitle={c.heroSubtitle}
>
  <!-- Challenges & Outcomes -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.problemsHeading}</h2>
    <TwoColumnSplit
      variant="challenges-solution"
      bare
      leftTitle={c.problemTitle}
      leftItems={c.problemItems}
      rightTitle={c.outcomeTitle}
      rightItems={c.outcomeItems}
    />
    <p class="list-footer">{c.listFooter}</p>
  </SectionWrapper>

  <!-- Data Platform Diagram -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.diagramHeading}</h2>
    <DataPlatformDiagram locale={locale} />
    <p class="caption">{c.diagramCaption}</p>
  </SectionWrapper>

  <!-- Each part of the platform: white cards -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.layersHeading}</h2>
    <div class="layers-grid">
      <div class="layer-card">
        <div class="layer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 2v6"/>
            <path d="M15 2v6"/>
            <path d="M12 17v5"/>
            <path d="M5 8h14"/>
            <path d="M6 11V8h12v3a6 6 0 1 1-12 0Z"/>
          </svg>
        </div>
        <h3 class="layer-title">{c.layer1Title}</h3>
        <p class="layer-body">{c.layer1Body}</p>
      </div>
      <div class="layer-card">
        <div class="layer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
          </svg>
        </div>
        <h3 class="layer-title" set:html={c.layer2TitleHtml}></h3>
        <p class="layer-body">{c.layer2Body}</p>
      </div>
      <div class="layer-card">
        <div class="layer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18"/>
            <path d="M18 17V9"/>
            <path d="M13 17V5"/>
            <path d="M8 17v-3"/>
          </svg>
        </div>
        <h3 class="layer-title" set:html={c.layer3TitleHtml}></h3>
        <p class="layer-body">{c.layer3Body}</p>
      </div>
    </div>
  </SectionWrapper>

  <!-- Technologies used -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.toolsHeading}</h2>
    <p class="intro-body">{c.toolsIntro}</p>
    <LogoGrid locale={locale} technologies={getTechnologiesForGrid(locale)} showTaglines={true} />
    <p class="see-all-link">
      <a href={href('technologies', locale)} set:html={c.toolsLinkHtml}></a>
    </p>
  </SectionWrapper>

  <!-- How it runs -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.processHeading}</h2>
    <ProcessSteps
      steps={c.processSteps}
    />
  </SectionWrapper>

  <!-- Pricing -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.pricingHeading}</h2>
    <div class="pricing-lead">
      <span class="pricing-label">{c.pricingLabel}</span>
      <span class="pricing-amount">{c.pricingAmount}</span>
      <p class="pricing-sub" set:html={c.pricingSubHtml}></p>
    </div>

    <PricingRange locale={locale}
      factors={c.pricingFactors}
      scenarios={c.pricingScenarios}
    />

    <div class="why-more">
      <h3 class="why-more-title">{c.whyMoreTitle}</h3>
      <div class="why-more__grid">
        <div class="why-more__reason">
          <h4 class="why-more__sub">{c.whyMore1Title}</h4>
          <p>{c.whyMore1Body}</p>
        </div>
        <div class="why-more__reason">
          <h4 class="why-more__sub">{c.whyMore2Title}</h4>
          <p>{c.whyMore2Body}</p>
        </div>
      </div>
    </div>

    <div class="payment-section">
      <h3 class="payment-heading">{c.paymentHeading}</h3>
      <p class="payment-body">{c.paymentBody}</p>
    </div>
  </SectionWrapper>

  <!-- Proof: Aeyde result block -->
  <SectionWrapper py="lg" bg="white">
    <ResultBlock locale={locale}
      metric={c.resultMetric}
      body={c.resultBody}
      caseStudySlug="aeyde"
    />
  </SectionWrapper>

  <!-- Cross-links: not the right fit -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">{c.fitHeading}</h2>
    <div class="leads-grid">
      <LeadCard {...serviceLeads.improve} eyebrow={c.leadImproveEyebrow} dataTrack="build-cta-improve" />
      <LeadCard {...serviceLeads.support} eyebrow={c.leadSupportEyebrow} dataTrack="build-cta-support" />
      <LeadCard {...serviceLeads.audit} eyebrow={c.leadAuditEyebrow} dataTrack="build-cta-audit" />
    </div>
  </SectionWrapper>
</ServiceLayout>

<style>
  .section-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-primary);
    margin: 0 0 32px 0;
    line-height: 1.25;
  }

  .list-footer {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 24px 0 0 0;
    max-width: 720px;
  }

  .caption {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 24px 0 0 0;
    max-width: 720px;
  }

  .see-all-link {
    text-align: center;
    margin: 32px 0 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .see-all-link a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .see-all-link a:hover {
    text-decoration: underline;
  }

  .intro-body {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 32px 0;
    max-width: 720px;
  }

  .layers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .layers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .layer-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-card);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .layer-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-teal);
  }

  .layer-icon svg {
    width: 32px;
    height: 32px;
  }

  .layer-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
  }

  .layer-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }

  /* Pricing */
  .pricing-lead {
    max-width: 720px;
    margin-bottom: 40px;
  }

  .pricing-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
  }

  .pricing-amount {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--color-brand-plum);
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .pricing-sub {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  /* Why replacing costs more (moved from the old Optimization page) */
  .why-more {
    margin-top: 40px;
  }

  .why-more-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 16px 0;
  }

  .why-more p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  .why-more__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .why-more__grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
  }

  .why-more__sub {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-plum);
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .pricing-sub :global(.inline-link) {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .leads-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .leads-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Inline link inside ProcessSteps descriptions */
  :global(.step-link) {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .payment-section {
    margin-top: 40px;
    max-width: 720px;
  }

  .payment-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 8px 0;
  }

  .payment-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
</style>

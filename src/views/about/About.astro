---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroStandard from '../../components/heroes/HeroStandard.astro';
import TextSection from '../../components/content/TextSection.astro';
import CTABanner from '../../components/cards/CTABanner.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import FounderBlock from '../../components/content/FounderBlock.astro';
import type { Locale } from '../../i18n/locales';
import { pickCopy } from '../../i18n/copy';
import { href } from '../../i18n/routes';
import en from './about.en';
import fr from './about.fr';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = pickCopy({ en, fr }, locale, 'views/about');

// Vendor facts a buyer's procurement or finance team asks for. Kept factual and
// unsold on purpose: this block exists to clear a checklist, not to persuade.
const procurementFacts: Array<{ label: string; value: string }> = c.procurementFacts;

type PrincipleIcon = 'compass' | 'database' | 'target' | 'tag' | 'message-square' | 'graduation-cap';

const principles: Array<{ icon: PrincipleIcon; title: string; body: string }> = c.principles;
---

<BaseLayout locale={locale}
  title={c.metaTitle}
  description={c.metaDescription}
>
  <HeroStandard
    title={c.heroTitle}
    subtitle={c.heroSubtitle}
    cta={{ text: c.heroCta, href: href('contact', locale), dataTrack: 'about-hero-cta' }}
  />

  <!-- Why Nimzo Data exists — editorial with sub-heads -->
  <SectionWrapper bg="white" py="lg">
    <div class="exists-section">
      <h2 class="section-heading">{c.existsHeading}</h2>
      <div class="reasons">
        <div class="reason">
          <h3 class="reason-title">{c.reason1Title}</h3>
          <p>{c.reason1Body}</p>
        </div>
        <div class="reason">
          <h3 class="reason-title">{c.reason2Title}</h3>
          <p>{c.reason2Body}</p>
        </div>
        <div class="reason">
          <h3 class="reason-title">{c.reason3Title}</h3>
          <p>{c.reason3Body}</p>
        </div>
      </div>
    </div>
  </SectionWrapper>

  <TextSection title={c.nameTitle} bg="white">
    <p>{c.nameBody}</p>
  </TextSection>

  <!-- The person behind the firm -->
  <SectionWrapper bg="white" py="lg">
    <h2 class="section-heading">{c.founderHeading}</h2>
    <FounderBlock locale={locale} variant="full" />
  </SectionWrapper>

  <!-- How we work -->
  <SectionWrapper bg="white" py="lg">
    <h2 class="section-heading">{c.principlesHeading}</h2>
    <div class="principles-grid">
      {principles.map((p) => (
        <div class="principle-card">
          <div class="principle-icon" aria-hidden="true">
            {p.icon === 'compass' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
            )}
            {p.icon === 'database' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                <path d="M3 12A9 3 0 0 0 21 12"/>
              </svg>
            )}
            {p.icon === 'target' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            )}
            {p.icon === 'tag' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/>
                <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>
              </svg>
            )}
            {p.icon === 'message-square' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            )}
            {p.icon === 'graduation-cap' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/>
                <path d="M22 10v6"/>
                <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
              </svg>
            )}
          </div>
          <h3 class="principle-title">{p.title}</h3>
          <p class="principle-body">{p.body}</p>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <!-- Vendor facts for procurement and finance -->
  <SectionWrapper bg="white" py="lg">
    <h2 class="section-heading">{c.procurementHeading}</h2>
    <dl class="facts-list">
      {procurementFacts.map((f) => (
        <div class="fact-row">
          <dt class="fact-label">{f.label}</dt>
          <dd class="fact-value">{f.value}</dd>
        </div>
      ))}
    </dl>
    <p class="facts-footer">{c.procurementFooter}</p>
  </SectionWrapper>

  <CTABanner locale={locale} dataTrack="about-cta" showFounder={false} />
</BaseLayout>

<style>
  .facts-list {
    margin: 0;
    max-width: 640px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .fact-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 560px) {
    .fact-row {
      flex-direction: row;
      align-items: baseline;
      gap: 24px;
    }

    /* Only in row mode: flex-basis follows the main axis, so leaving this on
       the stacked layout made every label 220px tall. */
    .fact-label {
      flex: 0 0 220px;
    }
  }

  .fact-label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .fact-value {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
  }

  .facts-footer {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 18px 0 0;
  }

  .section-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-primary);
    margin: 0 0 32px 0;
    line-height: 1.25;
  }

  .exists-section {
    max-width: 820px;
  }

  .reasons {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .reason-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .reason p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .principle-card {
    background-color: var(--color-bg-default);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-card);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .principle-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-teal);
  }

  .principle-icon svg {
    width: 28px;
    height: 28px;
  }

  .principle-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
  }

  .principle-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0;
    line-height: 1.65;
  }
</style>

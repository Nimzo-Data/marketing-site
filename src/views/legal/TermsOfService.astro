---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import type { Locale } from '../../i18n/locales';
import { pickCopy } from '../../i18n/copy';
import { href } from '../../i18n/routes';
import en from './terms.en';
import fr from './terms.fr';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = pickCopy({ en, fr }, locale, 'views/legal/terms');
---

<BaseLayout locale={locale}
  title={c.metaTitle}
  description={c.metaDescription}
>
  <SectionWrapper py="xl">
    <div class="legal-content">
      <h1>{c.l1}</h1>
      <p class="meta">{c.l2}</p>

      <p>
        <Fragment set:html={c.l3} />
      </p>
      <p>
        <Fragment set:html={c.l4} />
      </p>

      <h2>{c.l5}</h2>
      <p>
        <Fragment set:html={c.l6} />
      </p>

      <h2>{c.l7}</h2>
      <p>
        <Fragment set:html={c.l8} />
      </p>
      <ul>
        {c.l9.map((text) => <li>{text}</li>)}
      </ul>

      <h2>{c.l10}</h2>
      <p>
        <Fragment set:html={c.l11} />
      </p>
      <p>
        <Fragment set:html={c.l12} />
      </p>
      <p>
        <Fragment set:html={c.l13} />
      </p>

      <h2>{c.l14}</h2>
      <p>
        <Fragment set:html={c.l15} />
      </p>
      <p>
        <Fragment set:html={c.l16} />
      </p>
      <p>
        <Fragment set:html={c.l17} />
      </p>

      <h2>{c.l18}</h2>
      <p>
        <Fragment set:html={c.l19} />
      </p>

      <h2>{c.l20}</h2>
      <p>
        <Fragment set:html={c.l21} />
      </p>

      <h2>{c.l22}</h2>
      <p>
        <Fragment set:html={c.l23} />
      </p>
      <p>
        <Fragment set:html={c.l24} />
      </p>
      <p>
        <Fragment set:html={c.l25} />
      </p>

      <h2>{c.l26}</h2>
      <p>
        <Fragment set:html={c.l27} />
      </p>

      <h2>{c.l28}</h2>
      <p>
        <Fragment set:html={c.l29} />
      </p>

      <h2>{c.l30}</h2>
      <p>
        <Fragment set:html={c.l31} />
      </p>
    </div>
  </SectionWrapper>
</BaseLayout>

<style>
  .legal-content {
    max-width: 760px;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .legal-content h1 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .legal-content h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 40px 0 12px 0;
    line-height: 1.3;
  }

  .legal-content p {
    margin: 0 0 16px 0;
  }

  .legal-content ul {
    margin: 0 0 16px 0;
    padding-left: 24px;
  }

  .legal-content li {
    margin: 0 0 8px 0;
  }

  .legal-content .meta {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin: 0 0 32px 0;
  }

  .legal-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .legal-content :global(a:hover) {
    opacity: 0.75;
  }
</style>

---
import BaseLayout from './BaseLayout.astro';
import HeroStandard from '../components/heroes/HeroStandard.astro';
import CTABanner from '../components/cards/CTABanner.astro';
import type { Locale } from '../i18n/locales';
import { href } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { locale, title, description, heroTitle, heroSubtitle, ogTitle, ogDescription, ogImage, canonicalUrl } = Astro.props;

const serviceName = title.replace(/ \| Nimzo Data$/, '');

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  provider: {
    '@type': 'Organization',
    name: 'Nimzo Data',
  },
  name: serviceName,
  description,
  areaServed: 'Europe',
  serviceType: 'Data Consulting',
  ...(locale === 'fr' ? { inLanguage: 'fr' } : {}),
};
---

<BaseLayout {title} {description} {ogTitle} {ogDescription} {ogImage} {canonicalUrl} structuredData={serviceSchema}>
  <HeroStandard
    title={heroTitle}
    subtitle={heroSubtitle}
    cta={{ text: t(locale).components.ctaBanner.button, href: href('contact', locale), dataTrack: 'service-hero-cta' }}
  />
  <slot />
  <CTABanner locale={locale} dataTrack="service-layout-cta" />
</BaseLayout>

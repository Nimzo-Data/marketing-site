---
import BaseLayout from './BaseLayout.astro';
import HeroTech from '../components/heroes/HeroTech.astro';
import CTACard from '../components/cards/CTACard.astro';
import CTABanner from '../components/cards/CTABanner.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import { technologies } from '../data/technologies';
import { crossSell } from '../data/services';

interface Props {
  title: string;
  description: string;
  toolName: string;
  toolLogo?: string;
  toolCategory: string;
  heroPositioning: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  toolName,
  toolLogo,
  toolCategory,
  heroPositioning,
  ogTitle,
  ogDescription,
  ogImage,
} = Astro.props;

const resolvedLogo =
  toolLogo ?? technologies.find((t) => t.name === toolName)?.logoPath;
---

<BaseLayout {title} {description} {ogTitle} {ogDescription} {ogImage}>
  <HeroTech
    toolName={toolName}
    toolLogo={resolvedLogo}
    toolCategory={toolCategory}
    positioning={heroPositioning}
  />
  <slot />
  <SectionWrapper py="lg">
    <div class="cta-cards-grid">
      <CTACard
        {...crossSell.implementation}
        title="No data platform yet?"
        variant="link"
      />
      <CTACard
        {...crossSell.optimization}
        title="Platform exists but not working?"
        variant="link"
      />
      <CTACard
        {...crossSell.expert}
        title={`Need help with ${toolName}?`}
        variant="link"
      />
    </div>
  </SectionWrapper>
  <CTABanner dataTrack="tech-layout-cta" />
</BaseLayout>

<style>
  .cta-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .cta-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

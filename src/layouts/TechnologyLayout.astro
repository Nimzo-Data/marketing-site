---
import BaseLayout from './BaseLayout.astro';
import HeroTech from '../components/heroes/HeroTech.astro';
import LeadCard from '../components/cards/LeadCard.astro';
import CTABanner from '../components/cards/CTABanner.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import { techLogo } from '../data/technologies';
import { getServiceLeads } from '../data/services';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  toolName: string;
  toolLogo?: string;
  toolCategory: string;
  heroPositioning: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  locale = 'en',
  title,
  description,
  toolName,
  toolLogo,
  toolCategory,
  heroPositioning,
  ogTitle,
  ogDescription,
  ogImage,
} = Astro.props;

const resolvedLogo =
  toolLogo ?? techLogo(toolName);
const serviceLeads = getServiceLeads(locale);
---

<BaseLayout {title} {description} {ogTitle} {ogDescription} {ogImage}>
  <HeroTech
    toolName={toolName}
    toolLogo={resolvedLogo}
    toolCategory={toolCategory}
    positioning={heroPositioning}
  />
  <slot />
  <SectionWrapper py="lg">
    <div class="cta-cards-grid">
      <LeadCard {...serviceLeads.audit} eyebrow="Not sure what you need yet" dataTrack="tech-cta-audit" />
      <LeadCard {...serviceLeads.build} eyebrow="No data platform yet" dataTrack="tech-cta-build" />
      <LeadCard {...serviceLeads.improve} eyebrow={`Need help with ${toolName}`} dataTrack="tech-cta-improve" />
    </div>
  </SectionWrapper>
  <CTABanner locale={locale} dataTrack="tech-layout-cta" />
</BaseLayout>

<style>
  .cta-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .cta-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

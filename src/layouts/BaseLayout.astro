---
import { getFounder } from '../data/founder';
import '../styles/global.css';
import CookieConsent from '../components/ui/CookieConsent.astro';
import Header from '../components/layout/Header.astro';
import FrenchOffer from '../components/layout/FrenchOffer.astro';
import Footer from '../components/layout/Footer.astro';
import type { Locale } from '../i18n/locales';
import { ogLocale } from '../i18n/locales';
import { routes, routeIdForPath, alternateLinks, href, type RouteId } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** 'article' on blog posts, so shares are typed correctly. */
  ogType?: string;
  canonicalUrl?: string;
  structuredData?: object | object[];
  /** Page language. Defaults to English. */
  locale?: Locale;
  /** Route map id; derived from the URL when omitted. */
  routeId?: RouteId;
  /** This page's URL in each language, for pages outside the route map (blog posts). */
  alternates?: Record<Locale, string>;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = '/og-image.png',
  ogType = 'website',
  canonicalUrl,
  structuredData,
  locale = 'en',
  routeId,
  alternates,
} = Astro.props;

const ui = t(locale);
const founder = getFounder(locale);
const resolvedRouteId = routeId ?? routeIdForPath(Astro.url.pathname);
// This page in each language: drives the switch, hreflang and og:locale:alternate.
const paths = alternates ?? (resolvedRouteId ? routes[resolvedRouteId] : undefined);
const hreflangs = paths ? alternateLinks(paths, Astro.site!) : [];

const canonical = canonicalUrl || Astro.url.href;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;

// Organization JSON-LD (every page)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Nimzo Data',
  url: 'https://nimzodata.com',
  description: ui.site.organizationDescription,
  email: 'hello@nimzodata.com',
  foundingDate: '2024',
  areaServed: 'Europe',
  founder: {
    '@type': 'Person',
    name: founder.name,
    jobTitle: founder.role,
    ...(founder.linkedin ? { sameAs: [founder.linkedin] } : {}),
    ...(founder.photo ? { image: new URL(founder.photo, 'https://nimzodata.com').href } : {}),
  },
};

// BreadcrumbList JSON-LD (skip on homepage and 404)
const isHomepage = ['/', '/fr/', '/404/'].includes(Astro.url.pathname);
const breadcrumbLabel = title.replace(/ \| Nimzo Data$/, '');

const breadcrumbSchema = !isHomepage
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      // English is the default reading; only French pages say so explicitly.
      ...(locale === 'fr' ? { inLanguage: 'fr' } : {}),
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: ui.site.breadcrumbHome,
          item: new URL(href('home', locale), 'https://nimzodata.com').href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: breadcrumbLabel,
          item: canonical,
        },
      ],
    }
  : null;

// Helper to safely serialise JSON-LD (XSS prevention)
function toJsonLd(schema: object): string {
  return JSON.stringify(schema)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');
}

// Collect all extra structuredData schemas passed via prop
const extraSchemas: object[] = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nimzo Data" />
    {hreflangs.length > 0 && (
      <>
        <meta property="og:locale" content={ogLocale(locale)} />
        <meta property="og:locale:alternate" content={ogLocale(locale === 'fr' ? 'en' : 'fr')} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Language alternates (only once French is built) -->
    {hreflangs.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={ui.site.rssTitle} href={locale === 'fr' ? '/fr/rss.xml' : '/rss.xml'} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!--
      Google tag (gtag.js) + Google Consent Mode v2.
      gtag.js loads on every page, but consent defaults to denied so no
      analytics/ad events fire until the user clicks Accept on the cookie
      banner. The banner script then calls `gtag('consent', 'update', ...)`
      to grant. If the user already accepted in a previous visit, we grant
      immediately on page load.
    -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-F9NHXY9R8E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        if (localStorage.getItem('nimzo-consent') === 'accepted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
      } catch (e) { /* localStorage unavailable */ }
      gtag('js', new Date());
      gtag('config', 'G-F9NHXY9R8E');
    </script>

    <!-- Structured Data: Organization (every page) -->
    <script is:inline type="application/ld+json" set:html={toJsonLd(organizationSchema)} />

    <!-- Structured Data: BreadcrumbList (all pages except homepage) -->
    {breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={toJsonLd(breadcrumbSchema)} />
    )}

    <!-- Structured Data: extra schemas from page/layout props -->
    {extraSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={toJsonLd(schema)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <!-- GA4 container — injected after consent -->
    <div id="ga4-container"></div>
    <FrenchOffer locale={locale} paths={paths} />
    <Header locale={locale} paths={paths} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
  </body>
</html>

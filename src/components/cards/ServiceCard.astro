---
import LineIcon, { type LineIconName } from '../ui/LineIcon.astro';

import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  eyebrow?: string;
  /** Small line icon shown left of the title. */
  icon?: LineIconName;
  title: string;
  description: string;
  priceRange?: string;
  timeline?: string;
  href: string;
  dataTrack?: string;
  linkText?: string;
  /** 'compact' tightens padding and title size, for two cards stacked in one column. */
  size?: 'default' | 'compact';
}

const {
  eyebrow,
  icon,
  title,
  description,
  priceRange,
  timeline,
  href,
  dataTrack,
  linkText = t(Astro.props.locale).components.learnMore,
  size = 'default',
} = Astro.props;
---

<a href={href} class={`service-card${size === 'compact' ? ' service-card--compact' : ''}`} data-track={dataTrack}>
  {eyebrow && <p class="card-eyebrow">{eyebrow}</p>}
  {icon ? (
    <div class="card-head">
      <span class="card-icon" aria-hidden="true">
        <LineIcon name={icon} />
      </span>
      <h3 class="card-title card-title--large">{title}</h3>
    </div>
  ) : (
    <h3 class="card-title">{title}</h3>
  )}
  <p class="card-description">{description}</p>
  {(priceRange || timeline) && (
    <div class="card-badges">
      {priceRange && <span class="badge badge-price">{priceRange}</span>}
      {timeline && <span class="badge badge-timeline">{timeline}</span>}
    </div>
  )}
  <span class="card-link">{linkText} <span class="card-arrow" aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 32px;
    background-color: var(--color-bg-default);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 150ms ease, transform 150ms ease, border-color 150ms ease;
  }

  .service-card:hover {
    box-shadow: var(--shadow-dropdown);
    transform: translateY(-2px);
    border-color: var(--color-brand-plum);
  }

  .card-eyebrow {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-plum);
    margin: 0;
    line-height: 1.2;
  }

  .card-title {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
    font-size: 1.25rem;
    margin: 0;
    margin-top: -4px;
    line-height: 1.3;
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .card-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 10px;
    color: var(--color-brand-teal);
    transition: border-color 150ms ease, color 150ms ease;
  }

  .card-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .service-card:hover .card-icon {
    border-color: var(--color-brand-plum);
    color: var(--color-brand-plum);
  }

  .card-title--large {
    font-size: 1.75rem;
    margin-top: 0;
    line-height: 1.1;
  }

  .card-description {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0;
    line-height: 1.65;
    flex: 1;
  }

  /* Price on the first row, duration on the second, on every card. */
  .card-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 100px;
    line-height: 1.4;
    background-color: transparent;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .badge-price {
    color: var(--color-brand-plum);
    border: 1px solid var(--color-brand-plum);
  }

  .badge-timeline {
    color: var(--color-brand-plum);
    border: 1px solid var(--color-brand-plum);
  }

  .service-card:hover .badge {
    background-color: var(--color-brand-plum);
    color: var(--color-text-on-dark);
  }

  .card-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-top: auto;
    padding-top: 4px;
  }

  .card-arrow {
    display: inline-block;
    transition: transform 150ms ease;
  }

  .service-card:hover .card-link {
    text-decoration: underline;
  }

  .service-card--compact {
    gap: 12px;
    padding: 24px 28px;
  }

  .service-card--compact .card-title--large {
    font-size: 1.375rem;
  }

  .service-card--compact .card-icon {
    width: 38px;
    height: 38px;
  }

  .service-card:hover .card-arrow {
    transform: translateX(4px);
  }
</style>

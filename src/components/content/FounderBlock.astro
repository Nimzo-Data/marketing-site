---
import { founder } from '../../data/founder';

interface Props {
  /** 'full' = the About block. 'compact' = one line beside a CTA. */
  variant?: 'full' | 'compact';
  /** 'dark' sits on the teal CTA banner, 'light' on a white section. */
  tone?: 'light' | 'dark';
}

// The compact variant deliberately omits the LinkedIn link: it sits directly
// under the primary CTA, and an outbound link at the conversion point competes
// with it. The link belongs on the full block on About.
const { variant = 'full', tone = 'light' } = Astro.props;
const { name, role, photo, photoAlt, linkedin, background, seniority, ctaLine } = founder;
---

<div class={`founder founder--${variant} founder--${tone}`}>
  <div class="founder-photo">
    {photo ? (
      <img src={photo} alt={photoAlt} class="founder-img" width="160" height="160" loading="lazy" />
    ) : (
      <div class="founder-placeholder" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false">
          <circle cx="12" cy="8.5" r="3.75" />
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke-linecap="round" />
        </svg>
      </div>
    )}
  </div>

  <div class="founder-body">
    {variant === 'full' ? (
      <>
        <p class="founder-name">{name}</p>
        <p class="founder-role">{role}</p>
        {background.map((line) => <p class="founder-line">{line}</p>)}
        <p class="founder-seniority">{seniority}</p>
        {linkedin && (
          <a href={linkedin} class="founder-link" rel="noopener" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.65h.05A4.17 4.17 0 0 1 17.6 8.7c4 0 4.4 2.5 4.4 5.9V21h-4v-5.6c0-1.34-.03-3.07-1.9-3.07-1.9 0-2.2 1.47-2.2 3v5.67h-4V9Z" />
            </svg>
            <span>{name} on LinkedIn</span>
          </a>
        )}
      </>
    ) : (
      <p class="founder-cta-line">{ctaLine}</p>
    )}
  </div>
</div>

<style>
  .founder {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* ---- Full block (About) ---- */
  .founder--full {
    align-items: flex-start;
    gap: 32px;
    flex-direction: column;
  }

  @media (min-width: 640px) {
    .founder--full {
      flex-direction: row;
    }
  }

  .founder--full .founder-photo,
  .founder--full .founder-img,
  .founder--full .founder-placeholder {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
  }

  .founder-img,
  .founder-placeholder {
    border-radius: var(--radius-card);
    object-fit: cover;
    display: block;
  }

  .founder-placeholder {
    background-color: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .founder-placeholder svg {
    width: 44%;
    height: 44%;
  }

  .founder-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0;
  }

  .founder-role {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 2px 0 14px;
  }

  .founder-line {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0 0 6px;
  }

  .founder-seniority {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 14px 0 0;
  }

  .founder-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }

  .founder-link svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .founder-link:hover span {
    text-decoration: underline;
  }

  /* ---- Compact (beside a CTA) ---- */
  .founder--compact {
    justify-content: center;
    gap: 14px;
    text-align: left;
    max-width: 520px;
    margin: 0 auto;
  }

  .founder--compact .founder-photo,
  .founder--compact .founder-img,
  .founder--compact .founder-placeholder {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .founder-cta-line {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* On the teal CTA banner the placeholder inverts so it stays visible. */
  .founder--dark .founder-cta-line {
    color: rgba(255, 255, 255, 0.85);
  }

  .founder--dark .founder-placeholder {
    background-color: rgba(255, 255, 255, 0.16);
    color: var(--color-white);
  }
</style>

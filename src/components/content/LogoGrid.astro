---
import type { Technology } from '../../data/technologies';

interface Props {
  technologies: Technology[];
  showTaglines?: boolean;
}

const { technologies, showTaglines = false } = Astro.props;
---

<div class={`logo-grid${showTaglines ? ' logo-grid--with-taglines' : ''}`}>
  {technologies.map((tech) => (
    <a
      href={`/technologies/${tech.slug}/`}
      class={`logo-item${showTaglines ? ' logo-item--with-tagline' : ''}`}
      aria-label={tech.name}
    >
      <div class="logo-img-wrapper">
        {tech.logoPath ? (
          <img
            src={tech.logoPath}
            alt={tech.name}
            width="48"
            height="48"
            class="logo-img"
            data-logo-img
            loading="lazy"
          />
        ) : null}
        <div
          class="logo-placeholder"
          style={tech.logoPath ? 'display:none' : 'display:flex'}
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="M21 15l-5-5L5 21" />
          </svg>
        </div>
      </div>
      <span class="logo-name">{tech.name}</span>
      {showTaglines && tech.tagline && (
        <span class="logo-tagline">{tech.tagline}</span>
      )}
    </a>
  ))}
</div>

<style>
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 480px) {
    .logo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 768px) {
    .logo-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .logo-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 20px 12px;
    background-color: var(--color-bg-default);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border-subtle);
    text-decoration: none;
    transition: box-shadow 150ms ease, transform 150ms ease, border-color 150ms ease;
    box-shadow: var(--shadow-card);
  }

  .logo-item:hover {
    box-shadow: var(--shadow-dropdown);
    transform: translateY(-2px);
    border-color: var(--color-brand-plum);
  }

  .logo-item--with-tagline {
    padding: 24px 16px;
    text-align: center;
  }

  .logo-img-wrapper {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
  }

  /* Shown only when a logo SVG fails to load. Deliberately a neutral mark, not
     initials: the tool name is always rendered below in .logo-name, and
     two-letter abbreviations collided (Dataform/Dagster both "DA") and misread
     as domain terms on a data site ("BI" for BigQuery, "AI" for Airbyte). */
  .logo-placeholder {
    width: 48px;
    height: 48px;
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
  }

  .logo-placeholder svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .logo-name {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text);
    text-align: center;
    line-height: 1.3;
  }

  .logo-item--with-tagline .logo-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .logo-tagline {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-align: center;
    line-height: 1.4;
    margin-top: 2px;
  }
</style>

<script>
  // Swap in the neutral placeholder when a logo fails to load. Astro currently
  // inlines this (it is small), but a <script> block can be cleared by a CSP
  // nonce or hash, whereas the onerror= attribute this replaced would need
  // 'unsafe-hashes' and cannot be covered by a nonce at all.
  document.querySelectorAll('img[data-logo-img]').forEach((img) => {
    const el = img as HTMLImageElement;
    const showPlaceholder = () => {
      el.style.display = 'none';
      const ph = el.parentElement?.querySelector<HTMLElement>('.logo-placeholder');
      if (ph) ph.style.display = 'flex';
    };
    if (el.complete && el.naturalWidth === 0) showPlaceholder();
    else el.addEventListener('error', showPlaceholder, { once: true });
  });
</script>

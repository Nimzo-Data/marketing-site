---
// Support tiers side by side. From 900px it is a table: each column header
// carries the tier name, subtitle and monthly price, the first row says who
// the tier is for, and the rows below compare what each tier includes.
// Below 900px each tier becomes a card: name, price and "for you if" at the
// top, then the first card lists everything it includes and each later card
// only what differs from the tier before it, under "Everything in X, plus:".
// No tier is highlighted on purpose.
export interface RetainerTier {
  name: string;
  subtitle: string;
  /** Shown as is, e.g. "€950 a month". */
  price: string;
  /** Completes "For you if…", lowercase start. */
  fit: string;
}

export interface RetainerRow {
  label: string;
  /** One value per tier: true = included, false = not included, string = shown as is. */
  values: (string | boolean)[];
}

interface Props {
  tiers: RetainerTier[];
  rows: RetainerRow[];
  fitLabel?: string;
}

const { tiers, rows, fitLabel = 'For you if' } = Astro.props;

const upperFirst = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const lowerFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---

<!-- Desktop comparison table -->
<div class="rt-desktop">
  <table class="rt-table">
    <thead>
      <tr>
        <td class="rt-th rt-th--label"></td>
        {tiers.map((tier) => (
          <th scope="col" class="rt-th">
            <div class="rt-th-name">{tier.name}</div>
            <div class="rt-th-sub">{tier.subtitle}</div>
            <div class="rt-th-price">{tier.price}</div>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr class="rt-fit-row">
        <th scope="row" class="rt-td rt-td--label">{fitLabel}</th>
        {tiers.map((tier) => <td class="rt-td">{upperFirst(tier.fit)}</td>)}
      </tr>
      {rows.map((row) => (
        <tr>
          <th scope="row" class="rt-td rt-td--label">{row.label}</th>
          {row.values.map((v) => (
            <td class="rt-td">
              {v === true && <span>Included</span>}
              {v === false && (<span class="rt-dash"><span class="rt-dash-bar" aria-hidden="true"></span><span class="rt-sr">Not included</span></span>)}
              {typeof v === 'string' && <span>{v}</span>}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<!-- Mobile stacked tier cards -->
<div class="rt-mobile">
  {tiers.map((tier, i) => (
    <div class="rt-card">
      <div>
        <h3 class="rt-card-name">{tier.name}</h3>
        <p class="rt-card-sub">{tier.subtitle}</p>
        <p class="rt-card-price">{tier.price}</p>
        <p class="rt-card-fit"><span>{fitLabel}</span> {tier.fit}.</p>
      </div>

      {i > 0 && <p class="rt-card-lead">Everything in {tiers[i - 1].name}, plus:</p>}
      <ul class="rt-card-list" role="list">
        {rows
          .filter((row) => row.values[i] !== false && (i === 0 || row.values[i] !== row.values[i - 1]))
          .map((row) => (
            <li class="rt-card-row">
              <span class="rt-tick" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 18 18"><circle cx="9" cy="9" r="9" fill="#004f4c" fill-opacity="0.12"/><path d="M5 9.5L7.5 12L13 7" stroke="#004f4c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
              </span>
              <span>{typeof row.values[i] === 'string' ? `${row.label}: ${lowerFirst(row.values[i] as string)}` : row.label}</span>
            </li>
          ))}
      </ul>
    </div>
  ))}
</div>

<style>
  /* Real text rather than aria-label, so the state survives plain text
     extraction (crawlers, LLM ingestion, copy-paste) as well as being
     announced. */
  .rt-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .rt-desktop { display: none; }
  .rt-mobile { display: grid; grid-template-columns: 1fr; gap: 20px; }

  @media (min-width: 900px) {
    .rt-desktop { display: block; }
    .rt-mobile { display: none; }
  }

  .rt-table {
    width: 100%;
    border-collapse: collapse;
    background-color: var(--color-white);
    border: 1px solid var(--color-card);
    table-layout: fixed;
  }

  .rt-th {
    padding: 20px 16px;
    text-align: left;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-card);
    vertical-align: bottom;
  }

  .rt-th--label {
    width: 31%;
  }

  .rt-th-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .rt-th-sub {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .rt-th-price,
  .rt-card-price {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-brand-plum);
    font-variant-numeric: tabular-nums;
  }

  .rt-th-price {
    margin-top: 10px;
  }

  .rt-td {
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-card);
  }

  .rt-td--label {
    font-weight: 500;
    color: var(--color-primary);
  }

  /* "For you if" row: set apart from the inclusions below it. */
  .rt-fit-row .rt-td {
    background-color: var(--color-surface-subtle);
  }

  .rt-tick { display: inline-flex; vertical-align: middle; }

  .rt-dash {
    display: inline-flex;
    align-items: center;
    height: 22px;
  }

  .rt-dash-bar {
    display: block;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background-color: color-mix(in srgb, var(--color-text-secondary) 55%, white);
  }

  /* Mobile cards */
  .rt-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-card);
    border-radius: var(--radius-card);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rt-card-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 0;
  }

  .rt-card-sub {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 2px 0 0 0;
  }

  .rt-card-price {
    margin: 10px 0 0 0;
  }

  .rt-card-fit {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 12px 0 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--color-card);
  }

  .rt-card-fit span {
    font-weight: 500;
    color: var(--color-primary);
  }

  .rt-card-lead {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin: 0 0 -6px 0;
  }

  .rt-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rt-card-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .rt-card-row .rt-tick {
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>

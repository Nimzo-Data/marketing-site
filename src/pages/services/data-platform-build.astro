---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import TwoColumnSplit from '../../components/content/TwoColumnSplit.astro';
import DataPlatformDiagram from '../../components/content/DataPlatformDiagram.astro';
import PricingRange from '../../components/content/PricingRange.astro';
import ProcessSteps from '../../components/content/ProcessSteps.astro';
import LogoGrid from '../../components/content/LogoGrid.astro';
import LeadCard from '../../components/cards/LeadCard.astro';
import { serviceLeads } from '../../data/services';
import ResultBlock from '../../components/content/ResultBlock.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import { technologiesForGrid } from '../../data/technologies';
---

<ServiceLayout
  title="Data Platform Build | Nimzo Data"
  description="We build Google Cloud data platforms end to end: ingestion, BigQuery, Dataform, and BI. New platforms, or replacements for one that has to go. Fixed price, after a paid audit."
  heroTitle="Your data is scattered across tools.<br>None of it talks to each other."
  heroSubtitle="A proper data platform, without hiring a data team. End-to-end, from ingestion to dashboards, built new or replacing a platform that has to go. Audit first, then a fixed-price build. Senior engineering, clean handover."
>
  <!-- Challenges & Outcomes -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">What brings most clients here.</h2>
    <TwoColumnSplit
      variant="challenges-solution"
      bare
      leftTitle="The problem:"
      leftItems={[
        "Your reporting runs on spreadsheets that break.",
        "Board reports take days to put together by hand.",
        "Teams get different answers to the same question.",
        "Every data question goes through one person.",
        "Your platform breaks weekly, and patching costs more than replacing.",
        "It runs on tools nobody on your team knows.",
        "You don't know if your data can support AI.",
      ]}
      rightTitle="What you get:"
      rightItems={[
        "Dashboards your team trusts and opens daily.",
        "Reports that run and send themselves.",
        "One definition per metric: revenue, churn, LTV.",
        "Self-service analytics, no ticket needed.",
        "A switchover only once the figures match.",
        "Docs your next hire can pick up.",
        "AI that answers questions from trusted data.",
      ]}
    />
    <p class="list-footer">We build the platform, we hand you the keys, and we leave, with a 30-day support window so your team lands cleanly.</p>
  </SectionWrapper>

  <!-- Data Platform Diagram -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">What we build, end to end.</h2>
    <DataPlatformDiagram />
    <p class="caption">Each layer chosen for your data volume, team skill, and budget, with the reasoning written down.</p>
  </SectionWrapper>

  <!-- Each part of the platform: white cards -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">Each part, done right.</h2>
    <div class="layers-grid">
      <div class="layer-card">
        <div class="layer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 2v6"/>
            <path d="M15 2v6"/>
            <path d="M12 17v5"/>
            <path d="M5 8h14"/>
            <path d="M6 11V8h12v3a6 6 0 1 1-12 0Z"/>
          </svg>
        </div>
        <h3 class="layer-title">Automated Data Pipelines</h3>
        <p class="layer-body">We connect your data sources (databases, APIs, SaaS tools) using Airbyte or Fivetran, depending on your needs. Data lands in BigQuery on a reliable schedule, with monitoring and alerts when something breaks.</p>
      </div>
      <div class="layer-card">
        <div class="layer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
          </svg>
        </div>
        <h3 class="layer-title">Data Architecture &amp; Modeling</h3>
        <p class="layer-body">Raw data is cleaned, modeled, and documented in Dataform or dbt. Staging, transformation, and reporting layers. Data quality tests built in from the start so issues surface before they hit dashboards.</p>
      </div>
      <div class="layer-card">
        <div class="layer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18"/>
            <path d="M18 17V9"/>
            <path d="M13 17V5"/>
            <path d="M8 17v-3"/>
          </svg>
        </div>
        <h3 class="layer-title">Dashboards, Reports &amp; AI-ready</h3>
        <p class="layer-body">We connect the BI tool that fits your team (Looker, Lightdash, Metabase, or Steep) and build the dashboards that matter. We also configure the AI features on top, so conversational analytics or AI agents query governed metrics, not raw tables.</p>
      </div>
    </div>
  </SectionWrapper>

  <!-- Technologies used -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">The tools we reach for.</h2>
    <p class="intro-body">Every build uses some combination of these. The mix depends on your data sources, team, and budget. We explain the tradeoffs before we pick.</p>
    <LogoGrid technologies={technologiesForGrid} showTaglines={true} />
    <p class="see-all-link">
      <a href="/technologies/">See all technologies and when we pick each &rarr;</a>
    </p>
  </SectionWrapper>

  <!-- How it runs -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">How a build runs.</h2>
    <ProcessSteps
      steps={[
        { icon: 'search', title: "Audit (1–2 weeks, €3,000 – €5,000)", description: "A verdict on each part of your platform and a fixed-price build proposal. <a href='/services/data-platform-audit/' class='step-link'>Available standalone</a>." },
        { icon: 'scale', title: "Your decision (no fees for deciding)", description: "Build with us, do it yourselves, or stop here. Taking the report in-house is a fine outcome." },
        { icon: 'code-2', title: "Build (6–14 weeks, bi-weekly demos)", description: "We lead the work, your team joins reviews. For a replacement, old and new run side by side until the figures match." },
        { icon: 'key-round', title: "Handover (1–2 weeks)", description: "Training, full documentation and recorded walkthroughs, so your team runs it without us." },
        { icon: 'life-buoy', title: "Post-launch support (30 days, included)", description: "Questions, tweaks, edge cases: we're reachable for 30 days at no extra cost." },
      ]}
    />
  </SectionWrapper>

  <!-- Pricing -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">Pricing.</h2>
    <div class="pricing-lead">
      <span class="pricing-label">Fixed price, build only</span>
      <span class="pricing-amount">€15,000 – €50,000</span>
      <p class="pricing-sub">8–16 weeks from kickoff to handover. Priced after the audit on the real scope, and agreed in writing before we start. The <a href="/services/data-platform-audit/" class="inline-link">audit</a> is priced separately. New platforms usually land at €15,000 – €35,000; replacing a running platform costs more, because old and new run in parallel until the numbers match, then we switch over.</p>
    </div>

    <PricingRange
      factors={[
        { name: "Starting point", low: "Nothing in place", high: "Replacing a running platform" },
        { name: "Number of data sources", low: "2–3 simple sources", high: "6–10 mixed sources" },
        { name: "Transformation complexity", low: "Standard model", high: "Complex business logic" },
        { name: "BI tool", low: "Steep / Metabase", high: "Lightdash / Looker with LookML" },
        { name: "Orchestration needs", low: "None needed", high: "Dagster-based workflow" },
      ]}
      scenarios={[
        { label: "Example: 3 sources, Metabase", price: "€15,000 – €18,000", duration: "8–10 weeks", description: "Startup with Postgres, Stripe, and HubSpot. Metabase for dashboards." },
        { label: "Example: 6+ sources, Looker", price: "€25,000 – €35,000", duration: "10–14 weeks", description: "Scale-up with product databases, marketing APIs, and finance tools. Looker with LookML." },
        { label: "Example: Shopify + ads, Lightdash", price: "€20,000 – €25,000", duration: "8–10 weeks", description: "E-commerce business with Shopify, ad platforms (Meta, Google), and a technical team that wants metrics defined in code. Lightdash on top." },
        { label: "Example: replacing a running platform", price: "€40,000 – €50,000", duration: "12–16 weeks", description: "Several parts migrated at once, complex data quality issues, and a parallel run before switchover." },
      ]}
    />

    <div class="why-more">
      <h3 class="why-more-title">Why does replacing a platform cost more than building from scratch?</h3>
      <div class="why-more__grid">
        <div class="why-more__reason">
          <h4 class="why-more__sub">Live systems</h4>
          <p>We replace your platform while it is in use. Migrations run in parallel, dashboards don't go dark, pipelines keep flowing while we replace them underneath. Building from scratch doesn't have that constraint.</p>
        </div>
        <div class="why-more__reason">
          <h4 class="why-more__sub">Interconnection</h4>
          <p>Most platforms have connected problems. Fixing the slow dashboard means fixing the model, which means fixing the pipeline. The scope is wider than it looks.</p>
        </div>
      </div>
    </div>

    <div class="payment-section">
      <h3 class="payment-heading">Payment</h3>
      <p class="payment-body">50% at start · 30% at the mid-project milestone · 20% on final handover. Fixed price. No change orders without a signed amendment. The audit is paid 100% upfront, before it starts.</p>
    </div>
  </SectionWrapper>

  <!-- Proof: Aeyde result block -->
  <SectionWrapper py="lg" bg="white">
    <ResultBlock
      metric="From minutes to seconds."
      body="Three layers replaced: ingestion, warehouse and modeling. Plus a 77% drop in infrastructure costs and 119 Looker derived tables collapsed into a single Dataform layer."
      caseStudySlug="aeyde"
    />
  </SectionWrapper>

  <!-- Cross-links: not the right fit -->
  <SectionWrapper py="lg" bg="white">
    <h2 class="section-heading">Not sure this is the right fit?</h2>
    <div class="leads-grid">
      <LeadCard {...serviceLeads.improve} eyebrow="One piece added, or fixes" dataTrack="build-cta-improve" />
      <LeadCard {...serviceLeads.support} eyebrow="Your platform already runs" dataTrack="build-cta-support" />
      <LeadCard {...serviceLeads.audit} eyebrow="Not sure what you need yet" dataTrack="build-cta-audit" />
    </div>
  </SectionWrapper>
</ServiceLayout>

<style>
  .section-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-primary);
    margin: 0 0 32px 0;
    line-height: 1.25;
  }

  .list-footer {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 24px 0 0 0;
    max-width: 720px;
  }

  .caption {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 24px 0 0 0;
    max-width: 720px;
  }

  .see-all-link {
    text-align: center;
    margin: 32px 0 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .see-all-link a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .see-all-link a:hover {
    text-decoration: underline;
  }

  .intro-body {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 32px 0;
    max-width: 720px;
  }

  .layers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .layers-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .layer-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-card);
    border-radius: var(--radius-card);
    padding: 28px 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .layer-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-teal);
  }

  .layer-icon svg {
    width: 32px;
    height: 32px;
  }

  .layer-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
  }

  .layer-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }

  /* Pricing */
  .pricing-lead {
    max-width: 720px;
    margin-bottom: 40px;
  }

  .pricing-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
  }

  .pricing-amount {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--color-brand-plum);
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .pricing-sub {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  /* Why replacing costs more (moved from the old Optimization page) */
  .why-more {
    margin-top: 40px;
  }

  .why-more-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 16px 0;
  }

  .why-more p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  .why-more__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .why-more__grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
  }

  .why-more__sub {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-plum);
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .inline-link {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .leads-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .leads-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Inline link inside ProcessSteps descriptions */
  :global(.step-link) {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .payment-section {
    margin-top: 40px;
    max-width: 720px;
  }

  .payment-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 8px 0;
  }

  .payment-body {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLarge from '../components/heroes/HeroLarge.astro';
import ServiceCard from '../components/cards/ServiceCard.astro';
import ServiceChip from '../components/ui/ServiceChip.astro';
import TwoColumnSplit from '../components/content/TwoColumnSplit.astro';
import ProcessSteps from '../components/content/ProcessSteps.astro';
import ProblemOutcomeCards from '../components/content/ProblemOutcomeCards.astro';
import LogoGrid from '../components/content/LogoGrid.astro';
import HomepageTestimonials from '../components/content/HomepageTestimonials.astro';
import CTABanner from '../components/cards/CTABanner.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';
import { getTechnologiesForGrid } from '../data/technologies';
import { getAudience } from '../data/audience';
const { isFor: isForItems, isNot: isNotForItems } = getAudience('en');

const problemRows: { problem: [string, string]; outcome: [string, string] }[] = [
  { problem: ["Finance says revenue is X. Marketing says Y.", "Leadership believes neither."], outcome: ["One definition per metric:", "revenue, CAC, LTV."] },
  { problem: ["One person is the bottleneck.", "Every data question routes through them."], outcome: ["Teams answer their own questions,", "no waiting."] },
  { problem: ["Manual reporting eats hours or days", "before every board meeting."], outcome: ["Reports that run automatically", "and email themselves."] },
  { problem: ["You inherited a platform, or built one fast.", "Nobody has checked it."], outcome: ["Audited and documented:", "what to keep, fix or drop."] },
];
---

<BaseLayout
  title="GCP Data Platforms for European Companies | Nimzo Data"
  ogTitle="Google Cloud data platforms for growing European companies"
  description="AI-ready Google Cloud data platforms for growing European companies. End-to-end builds on BigQuery, Dataform, Metabase or Lightdash. Paid audits, fixed-price."
>
  <!-- Section 1: Hero -->
  <HeroLarge
    title="You've outgrown spreadsheets. Everything else is too complicated."
    subtitle="We build Google Cloud data platforms for growing European companies.<br>Paid audits, fixed-price builds, senior engineering, clean handover so you own what we built."
    primaryCta={{ text: "Let's talk", href: '/contact/', dataTrack: 'hero-lets-talk' }}
  />

  <!-- Section 1b: Problems we solve -->
  <SectionWrapper bg="white" py="lg" class="problems-section">
    <h2 class="section-heading">What brings most clients here.</h2>
    <ProblemOutcomeCards locale="en" rows={problemRows} />
  </SectionWrapper>

  <!-- Section 2: Services. The cards say what each service is; "Where to start"
       shows the routes: Audit then Build or Improve, Improve directly, Support
       directly or after either. Build is never bought without an audit. -->
  <SectionWrapper bg="white" py="lg">
    <h2 class="section-heading">How we can help.</h2>
    <div class="svc-grid">
      <ServiceCard locale="en"
        size="compact"
        icon="audit"
        title="Audit"
        description="A verdict on each part of your platform (keep, fix, add or replace) and a fixed price for the next step."
        priceRange="€3,000 – €5,000"
        timeline="1–2 weeks"
        href="/services/data-platform-audit/"
        linkText="See Audit"
        dataTrack="home-card-audit"
      />
      <ServiceCard locale="en"
        size="compact"
        icon="build"
        title="Build"
        description="A new Google Cloud data platform, or a replacement for one that has to go. Priced after an audit."
        priceRange="€15,000 – €50,000"
        timeline="8–16 weeks"
        href="/services/data-platform-build/"
        linkText="See Build"
        dataTrack="home-card-build"
      />
      <ServiceCard locale="en"
        size="compact"
        icon="improve"
        title="Improve"
        description="Fix what's broken or add what's missing, one fixed-price project at a time."
        priceRange="€5,000 – €15,000 per project"
        timeline="2–6 weeks per project"
        href="/services/data-platform-improvement/"
        linkText="See Improve"
        dataTrack="home-card-improve"
      />
      <ServiceCard locale="en"
        size="compact"
        icon="support"
        title="Support"
        description="A senior engineer on call for monitoring, incidents and small improvements."
        priceRange="From €1,000/month"
        timeline="Month-to-month"
        href="/services/data-platform-support/"
        linkText="See Support"
        dataTrack="home-card-support"
      />
    </div>

    <div class="svc-routes">
      <h3 class="svc-routes__title">Where to start</h3>
      <ul class="svc-routes__list" role="list">
        <li class="svc-route">
          <div class="svc-route__when">
            <p class="svc-route__situation">Starting from scratch, or not sure what's wrong.</p>
            <p class="svc-route__note">The audit decides between Build and Improve, and prices it.</p>
          </div>
          <div class="svc-route__path" role="group" aria-label="Route: Audit, then Build or Improve">
            <span class="svc-route__unit"><ServiceChip locale="en" service="audit" dataTrack="home-route-audit" /><span class="svc-route__arrow" aria-hidden="true">&rarr;</span></span>
            <span class="svc-route__unit"><ServiceChip locale="en" service="build" dataTrack="home-route-audit-build" /><span class="svc-route__or">or</span><ServiceChip locale="en" service="improve" dataTrack="home-route-audit-improve" /></span>
          </div>
        </li>
        <li class="svc-route">
          <div class="svc-route__when">
            <p class="svc-route__situation">You already know the one thing to fix or add.</p>
            <p class="svc-route__note">We quote it after a free technical call. If it looks bigger, we recommend an audit first.</p>
          </div>
          <div class="svc-route__path" role="group" aria-label="Route: Improve directly"><ServiceChip locale="en" service="improve" dataTrack="home-route-improve-direct" /></div>
        </li>
        <li class="svc-route">
          <div class="svc-route__when">
            <p class="svc-route__situation">Your platform runs and you want someone on call.</p>
            <p class="svc-route__note">On its own, or after any project.</p>
          </div>
          <div class="svc-route__path" role="group" aria-label="Route: Support"><ServiceChip locale="en" service="support" dataTrack="home-route-support" /></div>
        </li>
      </ul>
    </div>
  </SectionWrapper>

  <!-- Section 3: Who we work with -->
  <SectionWrapper bg="white" py="lg">
    <h2 class="section-heading">Who we work with.</h2>
    <TwoColumnSplit
      variant="is-for"
      bare
      leftTitle="This is for you if:"
      leftItems={isForItems}
      rightTitle="This isn't for you if:"
      rightItems={isNotForItems}
    />
  </SectionWrapper>

  <!-- Section 4: How we work -->
  <SectionWrapper bg="white" py="lg">
    <h2 class="section-heading">How we work.</h2>
    <ProcessSteps
      steps={[
        { icon: 'video', title: "The discovery call", description: "Free 45-minute conversation. We listen, you talk, we tell you whether we're a fit." },
        { icon: 'file-text', title: "The proposal", description: "Usually a paid 1–2 week audit. If you already know the scope of an Improve project, we quote it directly." },
        { icon: 'code-2', title: "The work", description: "A Build or an Improve project. Weekly updates, bi-weekly demos, async by default." },
        { icon: 'key-round', title: "The handover", description: "Full documentation, walkthrough session, 30-day support window so your team owns what we built." },
      ]}
    />
  </SectionWrapper>

  <!-- Section 5: Why GCP only -->
  <SectionWrapper bg="white" py="lg">
    <div class="gcp-section">
      <div class="gcp-intro">
        <img src="/logos/googlecloud.svg" alt="" aria-hidden="true" class="gcp-logo" width="48" height="48" />
        <h2 class="section-heading gcp-heading">Why only<br />Google Cloud?</h2>
      </div>
      <div class="reasons">
        <div class="reason">
          <h3 class="reason-title">Your data is already there</h3>
          <p>If you run GA4, Google Ads, Google Sheets, and Workspace, most of your data already lives inside Google's ecosystem. BigQuery is its native landing zone: GA4 exports straight in, Google Ads arrives through the Data Transfer Service, Sheets queries in place as an external table. Nothing to buy and nothing to maintain for the sources you already have. That's the head start we build on.</p>
        </div>
        <div class="reason">
          <h3 class="reason-title">Built to work together</h3>
          <p>Google's data stack (BigQuery, Dataform, Looker, Cloud Storage) is designed as one platform: the services work together and share billing and monitoring. Specializing in it means we know it from years of daily production use, including where it breaks.</p>
        </div>
        <div class="reason">
          <h3 class="reason-title">What you get</h3>
          <p>Lower cloud costs, fewer integration headaches, and no time debugging five vendors blaming each other.</p>
        </div>
      </div>
    </div>
  </SectionWrapper>

  <!-- Section 6: Technology grid -->
  <SectionWrapper bg="white" py="lg">
    <div class="tech-header">
      <h2 class="section-heading">The tools we build with.</h2>
      <p class="section-sub">A focused set of tools, used selectively, not a buzzword list.</p>
    </div>
    <LogoGrid technologies={getTechnologiesForGrid('en')} showTaglines={true} />
    <p class="see-all-link">
      <a href="/technologies/">See all technologies and when we pick each &rarr;</a>
    </p>
  </SectionWrapper>

  <!-- Section 7: Testimonials -->
  <SectionWrapper bg="white" py="lg">
    <div class="tech-header">
      <h2 class="section-heading">What clients say.</h2>
    </div>
    <HomepageTestimonials locale="en" />
  </SectionWrapper>

  <!-- Section 8: Final CTA -->
  <CTABanner locale="en" dataTrack="homepage-cta-banner" />
</BaseLayout>

<style>
  .section-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-primary);
    margin: 0 0 40px 0;
    line-height: 1.25;
  }

  .text-center-wrap {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .prose p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 16px 0;
  }

  .gcp-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .gcp-section {
      grid-template-columns: minmax(220px, 1fr) 2fr;
      gap: 64px;
      align-items: start;
    }
  }

  .gcp-logo {
    display: block;
    margin: 0 0 16px 0;
    width: 48px;
    height: 48px;
  }

  .gcp-heading {
    margin: 0;
  }

  .reasons {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .reason-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .reason p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  .prose p:last-child { margin-bottom: 0; }

  .tech-header {
    margin-bottom: 32px;
  }

  .tech-header .section-heading {
    margin-bottom: 8px;
  }

  .section-sub {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .svc-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Where to start: one row per route, situation left, service chips right. */
  .svc-routes {
    margin-top: 48px;
  }

  .svc-routes__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 12px 0;
  }

  .svc-routes__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .svc-route {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .svc-route:first-child {
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .svc-route {
      /* Fixed chip column: wide enough for "Audit → Build or Improve" on one
         line, the same in every row so the chips line up, and the rest goes to
         the situation text so each note fits on one line on desktop. */
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: 24px;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .svc-route {
      gap: 32px;
    }
  }

  .svc-route__situation {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-primary);
    line-height: 1.4;
    margin: 0 0 2px 0;
  }

  .svc-route__note {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .svc-route__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }

  /* Wrapping only happens between units: "Audit →" | "Build or Improve". */
  .svc-route__unit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .svc-route__arrow {
    display: inline-flex;
    align-items: center;
    color: var(--color-brand-plum);
    font-size: 1.25rem;
    line-height: 1;
    transform: translateY(-1px);
  }

  .svc-route__or {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .see-all-link {
    text-align: center;
    margin: 32px 0 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .see-all-link a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .see-all-link a:hover {
    text-decoration: underline;
  }
</style>

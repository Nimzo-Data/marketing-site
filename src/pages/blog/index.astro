---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionWrapper from '../../components/ui/SectionWrapper.astro';
import CTABanner from '../../components/cards/CTABanner.astro';
import { getPublishedPosts, postUrl, formatPostDate, isoDate } from '../../data/blog';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog | GCP Data Engineering Articles | Nimzo Data"
  description="Data engineering articles from Nimzo Data. BigQuery optimization, Dataform modeling, GCP architecture, and lessons from real client engagements."
>
  <SectionWrapper py="xl" bg="white">
    <div class="blog-index">
      <header class="blog-header">
        <h1 class="blog-title">Blog</h1>
        <p class="blog-intro">
          Notes on building and running data platforms on Google Cloud: the calls we make, what they cost, and what we would do differently.
        </p>
      </header>

      {posts.length > 0 ? (
        <ul class="post-list" role="list">
          {posts.map((post) => (
            <li class="post-item">
              <a href={postUrl(post)} class="post-link">
                <time class="post-date" datetime={isoDate(post.data.pubDate)}>
                  {formatPostDate(post.data.pubDate)}
                </time>
                <h2 class="post-heading">{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="blog-empty">No posts published yet. The first one is on its way.</p>
      )}
    </div>
  </SectionWrapper>

  <CTABanner
    heading="Ready to talk about your data stack?"
    subtitle="45-minute call. No sales pitch."
    buttonText="Let's talk"
    buttonHref="/contact/"
    dataTrack="blog-index-cta"
  />
</BaseLayout>

<style>
  /* Sized for a handful of posts: one column, rules between entries, no cards
     and no grid. Three posts fill it the way thirty would. */
  .blog-index {
    max-width: 760px;
  }

  .blog-header {
    margin-bottom: 8px;
  }

  .blog-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .blog-intro {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .post-list {
    list-style: none;
    margin: 40px 0 0 0;
    padding: 0;
  }

  .post-item {
    border-top: 1px solid var(--color-border-subtle);
  }

  .post-item:last-child {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-link {
    display: block;
    padding: 28px 0;
    text-decoration: none;
  }

  .post-date {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .post-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--color-primary);
    margin: 0 0 10px 0;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .post-link:hover .post-heading {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-description {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
    line-height: 1.6;
  }

  .blog-empty {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 40px 0 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--color-border-subtle);
    line-height: 1.6;
  }
</style>
